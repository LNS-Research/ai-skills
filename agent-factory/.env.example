# ─── Database ────────────────────────────────────────────────────────────────
# Docker path (default):
DATABASE_URL=postgresql://agent:agentfactory@localhost:5432/agent_factory
# Supabase: copy the "connection string" from Project Settings → Database
# DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# ─── Discord ─────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=           # Bot → Token (from Discord Developer Portal)
DISCORD_TASK_CHANNEL_ID=     # Right-click channel → Copy Channel ID
DISCORD_WEBHOOK_URL=         # Channel Settings → Integrations → Webhooks → Copy URL

# ─── Agents — configure at least one ─────────────────────────────────────────

# Claude CLI (requires Claude Max subscription at claude.ai)
# Find your binary: `which claude`
CLAUDE_BIN=/usr/local/bin/claude

# Codex CLI (requires OpenAI subscription + Codex desktop app)
# Mac default: /Applications/Codex.app/Contents/Resources/codex
# CODEX_BIN=

# Local model via Ollama (free — install at https://ollama.ai then `ollama pull llama3.2`)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Remote node running llama.cpp (another machine on your network or Tailscale)
# BEAST_URL=http://192.168.1.x:8081
# BEAST_HEALTH_URL=http://192.168.1.x:8081/health

# Gemini CLI (install: npm install -g @google/gemini-cli  then: gemini auth)
# Uses your Google account — no API key needed. Find binary: `which gemini`
# GEMINI_BIN=/opt/homebrew/bin/gemini

# ─── Context hints (optional) ────────────────────────────────────────────────
# Auto-inject project context when a debate topic matches a keyword.
# JSON array of {pattern, context} objects.
# CONTEXT_HINTS_JSON=[{"pattern":"myproject","context":"MyProject is a ..."}]

# ─── Transport ───────────────────────────────────────────────────────────────
# discord (default) | file | both
# Use "file" if you don't want a Discord bot — agents read/write a local markdown file instead.
TRANSPORT=discord

# Required for Discord transport:
# DISCORD_BOT_TOKEN, DISCORD_TASK_CHANNEL_ID, DISCORD_WEBHOOK_URL (see above)

# Required for file transport:
# CONVERSATION_DIR=~/agent-chats   # folder for inbox.md + conversation.md (default: ./conversation)

# ─── Router ──────────────────────────────────────────────────────────────────
AGENT_ROUTER_ENABLED=1
